---
import Base from '../../layouts/Base.astro';
import Pacer from '../../components/Pacer.astro';
import Photo from '../../components/Photo.astro';
import BodyScan from '../../components/BodyScan.astro';
import { homeCopy, pageCopy, siteData } from '../../lib/site';
import { type Lang, t, url } from '../../i18n';

export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'es' } }]; }
const lang = Astro.params.lang as Lang;
const c = await homeCopy(lang);
const meta = await pageCopy(lang, 'home');
const site = await siteData();
const book = url(`${lang}/book/`);
const [, roman, italic] = c.hero.headline.match(/^(.*?)\s*\*(.*)\*\s*$/) ?? [, c.hero.headline, ''];
const n = c.pillars.items.length;
const cols = n <= 6 ? n : 4;
const tints = ['t1', 't2', 't3', 't4', 't5', 't6'];
const [mu, md] = site.email ? site.email.split('@') : ['', ''];
const mailFallback = site.email ? `${mu} (at) ${md.replace(/\./g, ' (dot) ')}` : '';
const wa = site.whatsapp && `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t(lang, 'contact.whatsappMessage'))}`;
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: c.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base lang={lang} title={meta.labels['Page title']} description={meta.labels['Meta description']} draftTranslation={lang === 'es' && c.translation_status === 'draft'}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <main id="main">
    <section class="hero" id="intro" data-hero aria-labelledby="h-hero">
      <div class="wrap grid">
        <div class="hero-text">
          <h1 class="display" id="h-hero"><span class="line"><span>{roman}</span></span> {italic && <span class="line"><em>{italic}</em></span>}</h1>
          <p class="lede">{c.hero.subhead}</p>
          <p class="ctas"><a class="btn" href={book}>{c.hero.primary}</a><a class="btn btn-ghost" href="#programme">{c.hero.secondary}</a></p>
        </div>
        <div class="hero-pacer"><Pacer lang={lang} hint={c.hero.pacerHint} /></div>
      </div>
    </section>

    <section class="section tinted pillars-sec" id="pillars" aria-labelledby="h-pillars">
      <div class="wrap">
        <div class="grid sec-head"><h2 class="h2" id="h-pillars">{c.pillars.heading}</h2><p class="sec-intro">{c.pillars.intro}</p></div>
        <p class="mono swipe-hint" aria-hidden="true">{t(lang, 'pillars.swipe', { n })}</p>
      </div>
      <div class="pillar-scroll" tabindex="0" role="region" aria-label={t(lang, 'pillars.region', { heading: c.pillars.heading })}>
        <ol class="pillar-row" style={`--cols:${cols}`}>
          {c.pillars.items.map((p, i) => (
            <li class:list={['pillar', { 'row-start': i % cols === 0, 'row-end': (i + 1) % cols === 0 || i === n - 1 }]} id={`pillar-${p.id}`}>
              <svg class="col-capital" viewBox="0 0 100 26" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect x="1" y="1" width="98" height="7" rx="1" /><path d="M7 8 C10 15 20 18 50 18 C80 18 90 15 93 8" /><path d="M10 22 H90 M10 25 H90" /></svg>
              <svg class="col-base" viewBox="0 0 100 24" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M10 1 H90 M10 4 H90" /><path d="M10 4 C5 4 4 11 7 12 H93 C96 11 95 4 90 4" /><rect x="2" y="14" width="96" height="9" rx="1" /></svg>
              <div class="pillar-media"><Photo slot={`pillar:${p.id}`} lang={lang} tint={tints[i % 6]} sizes="(min-width: 1024px) 16vw, 78vw" /></div>
              <p class="mono pillar-n">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="pillar-name">{p.name}</h3>
              <p class="pillar-desc">{p.description}</p>
              <p class="pillar-practice"><span class="mono">{t(lang, 'pillars.try')}</span>{p.practice}</p>
              <p class="pillar-why">{p.why}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section programme" id="programme" aria-labelledby="h-programme">
      <div class="wrap grid">
        <div class="prog-head"><h2 class="h2" id="h-programme">{c.programme.heading}</h2><p class="sec-intro">{c.programme.intro}</p></div>
        <div class="prog-photo"><Photo slot="P06" lang={lang} tint="t4" sizes="(min-width: 1024px) 40vw, 100vw" /></div>
        <ol class="timeline">
          {c.programme.phases.map((p) => (
            <li class="step"><p class="mono step-n">{p.label} {p.num}</p><h3 class="h3">{p.name}</h3><p>{p.text}</p></li>
          ))}
        </ol>
        <div class="included-row"><h3 class="mono included-h">{t(lang, 'programme.included')}</h3><ul class="included">{c.programme.included.map((x) => <li>{x}</li>)}</ul></div>
        <p class="price">{c.programme.price}</p>
      </div>
    </section>

    <section class="section about-teaser" id="about" aria-labelledby="h-about">
      <div class="wrap grid">
        <div class="about-photo"><Photo slot="P03" lang={lang} tint="t5" sizes="(min-width: 1024px) 30vw, 100vw" /></div>
        <div class="about-text">
          <h2 class="h2" id="h-about">{c.about.heading}</h2>
          <p class="about-body">{c.about.body}</p>
          <ul class="facts">{c.about.facts.map((f) => <li>{f}</li>)}</ul>
          <a class="more draw" href={url(`${lang}/about/`)}>{c.about.link} →</a>
        </div>
        <div class="about-widget"><BodyScan lang={lang} /></div>
      </div>
    </section>

    <section class="section faq" id="faq" aria-labelledby="h-faq">
      <div class="wrap grid">
        <h2 class="h2" id="h-faq">{c.faq.heading}</h2>
        <div class="faq-list">
          {c.faq.items.map((f) => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
        </div>
      </div>
    </section>

    <section class="night final" id="book" aria-labelledby="h-book">
      <div class="final-bg" aria-hidden="true"><Photo slot="P16" lang={lang} tint="night-alt" /></div>
      <svg class="final-orbit" viewBox="-400 -160 800 320" aria-hidden="true" focusable="false"><g transform="rotate(-10)"><ellipse rx="390" ry="118" /></g><circle class="final-electron" cx="318" cy="-78" r="6" /></svg>
      <div class="wrap grid final-inner">
        <div class="final-text">
          <h2 class="h2" id="h-book">{c.finalCta.heading}</h2>
          <p class="lede">{c.finalCta.body}</p>
          <p class="ctas"><a class="btn btn-warm" href={book}>{c.finalCta.primary}</a></p>
        </div>
        <ul class="contact-list">
          {site.email && <li><span class="mono">{t(lang, 'contact.email')}</span>
            <a href={book} data-mail data-u={mu} data-d={md} data-subject={t(lang, 'contact.subject')}>{c.finalCta.email}</a>
            <span class="mail-text" data-mail-text data-u={mu} data-d={md}>{mailFallback}</span></li>}
          {wa && <li><span class="mono">{t(lang, 'contact.whatsapp')}</span><a href={wa} rel="noopener">{c.finalCta.whatsapp}</a></li>}
        </ul>
      </div>
    </section>
  </main>
  <div slot="after" class="mobile-cta off" data-mobile-cta inert><a class="btn" href={book}>{c.hero.primary}</a></div>
</Base>
