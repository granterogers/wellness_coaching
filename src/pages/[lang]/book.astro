---
import Base from '../../layouts/Base.astro';
import { pageCopy, siteData } from '../../lib/site';
import { type Lang, t } from '../../i18n';

export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'es' } }]; }
const lang = Astro.params.lang as Lang;
const p = await pageCopy(lang, 'book');
const site = await siteData();
const [mu, md] = site.email.split('@');
const wa = site.whatsapp && `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t(lang, 'contact.whatsappMessage'))}`;
---
<Base lang={lang} title={p.labels['Page title']} description={p.labels['Meta description']} path="book/" draftTranslation={p.translation_status === 'draft'}>
  <main id="main">
    <section class="page-head"><div class="wrap">
      <h1 class="display">{p.labels['Heading']}</h1>
      <p class="lede">{p.labels['Intro']}</p>
    </div></section>
    <section class="section night book-box" id="book"><div class="wrap grid">
      {site.bookingUrl ? (
        // Requirement 11.2: a plain link to the booking page; any embed only loads after a click (no cookies before then).
        <div class="final-text"><p class="ctas"><a class="btn btn-warm" href={site.bookingUrl} rel="noopener">{p.labels['Heading']}</a></p></div>
      ) : (
        <div class="final-text">
          <h2 class="h2">{p.labels['Booking fallback heading']}</h2>
          <p class="lede">{p.labels['Booking fallback body']}</p>
          <p class="ctas">
            <a class="btn btn-warm" href="#book" data-mail data-u={mu} data-d={md} data-subject={t(lang, 'contact.subject')}>{p.labels['Email button']}</a>
            {wa && <a class="btn btn-ghost" href={wa} rel="noopener">{p.labels['WhatsApp button']}</a>}
          </p>
          <p class="mail-text" data-mail-text data-u={mu} data-d={md}>{t(lang, 'contact.emailFallback')}</p>
        </div>
      )}
    </div></section>
  </main>
</Base>
