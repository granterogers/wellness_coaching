---
// Mini Yoga Nidra body scan (requirement 9.13): a small figure lying down, seen from above (head at the top),
// in the pacer's thin line style, inside the same orbit with a drifting "electron".
// Zones glow in turn (feet → face) with the 4 s / 6 s breath; tap for the guided two-minute scan;
// ambient loop pausable (WCAG 2.2.2); reduced motion = highlight only.
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; title: string; text: string }
const { lang, title, text } = Astro.props;
const zones = ['feet', 'legs', 'hips', 'belly', 'chest', 'arms', 'shoulders', 'face'] as const;
const names = Object.fromEntries(zones.map((z) => [z, t(lang, `scan.${z}` as any)]));
const S = { names, count: t(lang, 'scan.count', { n: '{n}' }), done: t(lang, 'scan.done'), stopped: t(lang, 'pacer.stopped'), pause: t(lang, 'pacer.pause'), resume: t(lang, 'pacer.resume') };
// Left-side shapes, about 7.5 heads tall; the right side is mirrored across x = 100.
const mirror = 'translate(200 0) scale(-1 1)';
const torso = 'M86 76 C70 78 58 82 56 96 C56 112 60 124 62 134 C64 150 72 160 72 174 C72 186 64 196 64 208 C64 220 70 230 82 236 L118 236 C130 230 136 220 136 208 C136 196 128 186 128 174 C128 160 136 150 138 134 C140 124 144 112 144 96 C142 82 130 78 114 76 Z';
const arm = 'M58 90 C48 108 44 138 44 168 C42 196 38 222 36 244 L47 246 C50 222 54 196 56 170 C57 152 60 138 63 124 Z';
const leg = 'M66 212 C63 250 63 290 67 322 C70 350 73 375 76 398 L88 398 C88 375 91 350 93 322 C96 290 98 262 100 236 L82 236 C74 232 68 224 66 212 Z';
---
<section class="section bodyscan" id="restore-scan" aria-labelledby="h-scan">
  <div class="wrap scan-wrap">
    <div class="scan-text">
      <p class="mono eyebrow">{t(lang, 'scan.label')}</p>
      <h2 class="h2" id="h-scan">{title}</h2>
      <p>{text}</p>
      <p class="scan-hint" id={`scan-hint-${lang}`}>{t(lang, 'scan.hint')}</p>
      <p class="scan-meta"><span class="mono">{t(lang, 'scan.timing')}</span>
        <button type="button" class="link-btn mono" data-scan-pause aria-pressed="false">{S.pause}</button>
        <button type="button" class="link-btn mono" data-scan-stop hidden>{t(lang, 'pacer.stop')}</button></p>
    </div>
    <figure class="scan-figure" data-scan data-strings={JSON.stringify(S)}>
      <button type="button" class="scan-btn" aria-describedby={`scan-hint-${lang}`} aria-label={t(lang, 'scan.region')} data-scan-start>
        <svg viewBox="-40 -10 280 460" aria-hidden="true" focusable="false">
          <ellipse class="scan-orbit" cx="100" cy="222" rx="124" ry="230" transform="rotate(-6 100 222)" />
          <g class="bz" data-zone="feet">
            <ellipse class="shape" cx="79" cy="413" rx="7.5" ry="16" transform="rotate(22 79 413)" />
            <g transform={mirror}><ellipse class="shape" cx="79" cy="413" rx="7.5" ry="16" transform="rotate(22 79 413)" /></g>
          </g>
          <g class="bz" data-zone="legs"><path class="shape" d={leg} /><g transform={mirror}><path class="shape" d={leg} /></g></g>
          <g class="bz" data-zone="arms">
            <path class="shape" d={arm} /><ellipse class="shape" cx="40" cy="261" rx="6.5" ry="14" transform="rotate(8 40 261)" />
            <g transform={mirror}><path class="shape" d={arm} /><ellipse class="shape" cx="40" cy="261" rx="6.5" ry="14" transform="rotate(8 40 261)" /></g>
          </g>
          <path class="shape" d={torso} />
          <path class="shape" d="M90 62 L110 62 L112 78 L88 78 Z" />
          <g class="bz" data-zone="hips"><ellipse class="area" cx="100" cy="214" rx="30" ry="15" /></g>
          <g class="bz" data-zone="belly"><ellipse class="area" cx="100" cy="176" rx="22" ry="20" /></g>
          <g class="bz" data-zone="chest"><ellipse class="area" cx="100" cy="124" rx="30" ry="24" /></g>
          <g class="bz" data-zone="shoulders"><ellipse class="area" cx="100" cy="90" rx="40" ry="10" /></g>
          <g class="bz" data-zone="face"><ellipse class="shape" cx="100" cy="40" rx="20" ry="25" /></g>
          <circle class="scan-electron" r="5" cx="222" cy="222" data-scan-electron />
        </svg>
      </button>
      <figcaption class="scan-zone-label" aria-hidden="true"><span data-scan-name>{names.feet}</span><span class="mono" data-scan-count></span></figcaption>
      <p class="sr-only" aria-live="polite" data-scan-live></p>
    </figure>
  </div>
</section>
<script>import '../scripts/bodyscan.ts';</script>
