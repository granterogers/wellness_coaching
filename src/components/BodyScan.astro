---
// Mini Yoga Nidra body scan (requirement 9.13): a small widget, the same scale as the breath pacer.
// A figure lying on its back, seen from above (head at the top), so the person's RIGHT side is on the viewer's left.
// The body is one continuous outline (left half drawn, right half mirrored); 23 parts are bands clipped to it.
import { t, type Lang } from '../i18n';
import { voiceFor, transcriptFor } from '../lib/audio';
interface Props { lang: Lang }
const { lang } = Astro.props;
const side = ['hand', 'forearm', 'upperarm', 'shoulder', 'hip', 'thigh', 'lowerleg', 'foot'];
const zones = [...side.map((z) => `r-${z}`), ...side.map((z) => `l-${z}`), 'crown', 'face', 'throat', 'chest', 'belly', 'pelvis', 'whole'];
const names = Object.fromEntries([...zones, 'settle'].map((z) => [z, t(lang, `scan.${z}` as any)]));
const S = {
  zones, names, count: t(lang, 'scan.count', { n: '{n}' }), done: t(lang, 'scan.done'), stopped: t(lang, 'pacer.stopped'),
  listen: t(lang, 'voice.listen'), stop: t(lang, 'pacer.stop'), toCome: t(lang, 'voice.toCome'),
};
const audio = voiceFor('bodyscan', lang);
const transcript = transcriptFor('bodyscan', lang);
const M = 'translate(200 0) scale(-1 1)';
// Proportions: about 8 heads tall. Crown y 8, chin 60, shoulders 80, chest 112, navel 164, crotch 220, knee 322, ankle 400.
const halfOpen = 'M100 8 C89 8 82 16 82 29 C82 41 85 51 91 57 L92 64 C91 72 80 77 66 81 C59 83 55 86 54 92 C56 100 62 106 64 112 C64 130 70 150 72 165 C73 180 66 192 64 204 C63 212 64 222 66 234 C67 262 70 296 70 322 C69 334 66 344 67 356 C68 372 74 388 75 400 C73 410 66 422 66 430 C66 437 72 439 76 434 C81 426 84 412 85 401 C86 388 90 372 90 356 C90 344 88 334 88 322 C88 296 94 262 97 236 C98 228 99 222 100 220';
const half = `${halfOpen} L100 8 Z`;
const arm = 'M55 86 C46 92 42 106 41 122 C40 140 37 158 36 174 C35 192 33 212 31 233 C30 241 27 248 27 256 C27 266 31 272 35 272 C39 272 41 264 41 256 C41 249 41 243 41 236 C43 214 45 194 46 176 C47 160 49 140 56 118 C58 108 60 96 60 88 Z';
const band = (y: number, h: number, clip: string, x = 0, w = 200) => `<rect x="${x}" y="${y}" width="${w}" height="${h}" clip-path="url(#${clip})"/>`;
const sideParts = (p: string) => [
  [`${p}-hand`, band(236, 40, 'bsArm')],
  [`${p}-forearm`, band(174, 62, 'bsArm')],
  [`${p}-upperarm`, band(84, 90, 'bsArm')],
  [`${p}-shoulder`, `<ellipse cx="68" cy="94" rx="24" ry="15" clip-path="url(#bsHalf)"/>`],
  [`${p}-hip`, band(190, 36, 'bsHalf', 56, 30)],
  [`${p}-thigh`, band(226, 96, 'bsHalf', 56, 44)],
  [`${p}-lowerleg`, band(322, 78, 'bsHalf', 56, 44)],
  [`${p}-foot`, band(400, 42, 'bsHalf', 56, 44)],
];
const centre = [
  ['crown', band(6, 24, 'bsBody', 70, 60)],
  ['face', band(30, 31, 'bsBody', 70, 60)],
  ['throat', band(61, 15, 'bsBody', 86, 28)],
  ['chest', band(92, 48, 'bsBody', 56, 88)],
  ['belly', band(140, 50, 'bsBody', 56, 88)],
  ['pelvis', band(190, 34, 'bsBody', 86, 28)],
];
const g = ([z, el]: string[]) => `<g class="bz" data-zone="${z}">${el}</g>`;
const svg = `
<defs>
  <path id="bsHalfP" d="${half}"/><path id="bsArmP" d="${arm}"/>
  <clipPath id="bsHalf"><use href="#bsHalfP"/></clipPath>
  <clipPath id="bsArm"><use href="#bsArmP"/></clipPath>
  <clipPath id="bsBody"><use href="#bsHalfP"/><use href="#bsHalfP" transform="${M}"/></clipPath>
  <mask id="bsNoArm" maskUnits="userSpaceOnUse" x="-40" y="-20" width="280" height="480"><rect x="-40" y="-20" width="280" height="480" fill="white"/><use href="#bsArmP" fill="black"/><use href="#bsArmP" transform="${M}" fill="black"/></mask>
  <mask id="bsNoBody" maskUnits="userSpaceOnUse" x="-40" y="-20" width="280" height="480"><rect x="-40" y="-20" width="280" height="480" fill="white"/><use href="#bsHalfP" fill="black"/><use href="#bsHalfP" transform="${M}" fill="black"/></mask>
</defs>
<ellipse class="scan-orbit" cx="100" cy="222" rx="118" ry="228" transform="rotate(-6 100 222)"/>
<g class="sil"><use href="#bsHalfP"/><use href="#bsHalfP" transform="${M}"/><use href="#bsArmP"/><use href="#bsArmP" transform="${M}"/></g>
<g class="zones">${sideParts('r').map(g).join('')}<g transform="${M}">${sideParts('l').map(g).join('')}</g>${centre.map(g).join('')}</g>
<g class="lines"><g mask="url(#bsNoArm)"><path d="${halfOpen}"/><path d="${halfOpen}" transform="${M}"/></g><g mask="url(#bsNoBody)"><path d="${arm}"/><path d="${arm}" transform="${M}"/></g></g>
<circle class="scan-electron" r="5" cx="218" cy="222" data-scan-electron/>`;
---
<figure class="scan" data-scan data-strings={JSON.stringify(S)} id="restore-scan">
  <p class="mono scan-label">{t(lang, 'scan.label')}</p>
  <button type="button" class="scan-btn" aria-describedby={`scan-hint-${lang}`} aria-label={t(lang, 'scan.region')} data-scan-start>
    <svg viewBox="-30 -12 260 464" aria-hidden="true" focusable="false" set:html={svg} />
  </button>
  <p class="scan-zone-label" aria-hidden="true"><span data-scan-name>{names['r-hand']}</span><span class="mono" data-scan-count></span></p>
  <figcaption>
    <p class="scan-hint" id={`scan-hint-${lang}`}>{t(lang, 'scan.hint')}</p>
    <p class="scan-meta"><span class="mono">{t(lang, 'scan.timing')}</span>
      <button type="button" class="link-btn mono listen-btn" data-listen>{S.listen}</button>
      {!audio && <span class="mono voice-soon" data-voice-soon hidden>{S.toCome}</span>}</p>
    {transcript && <details class="transcript"><summary class="mono">{t(lang, 'voice.transcript')}</summary>{transcript.map((l) => <p>{l}</p>)}</details>}
  </figcaption>
  <p class="sr-only" aria-live="polite" data-scan-live></p>
  {audio && <audio preload="none" src={audio} data-voice></audio>}
</figure>
<script>import '../scripts/bodyscan.ts';</script>
