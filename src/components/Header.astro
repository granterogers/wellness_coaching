---
import { iconSvg, flagUK, flagES } from '../lib/brand';
import { siteData, homeCopy } from '../lib/site';
import { type Lang, t, url } from '../i18n';
interface Props { lang: Lang; path?: string }
const { lang, path = '' } = Astro.props;
const site = await siteData();
const copy = await homeCopy(lang);
const home = url(`${lang}/`);
const nav = [
  ['nav.pillars', 'pillars'], ['nav.programme', 'programme'], ['nav.about', 'about'], ['nav.contact', 'book'],
] as const;
---
<a class="skip" href="#main">{t(lang, 'skip')}</a>
<header class="site-header" data-header>
  <div class="wrap header-row">
    <a class="brand" href={home}><Fragment set:html={iconSvg} /><span class="wordmark">{site.name}</span></a>
    <nav class="nav" aria-label={t(lang, 'nav.main')}>
      {nav.map(([k, id]) => <a class="draw" href={`${home}#${id}`}>{t(lang, k)}</a>)}
    </nav>
    <button type="button" class="theme-btn" data-theme-toggle aria-label={t(lang, 'theme.toDarkLabel')}
      data-l-dark={t(lang, 'theme.toDark')} data-l-light={t(lang, 'theme.toLight')}
      data-a-dark={t(lang, 'theme.toDarkLabel')} data-a-light={t(lang, 'theme.toLightLabel')}>
      <svg class="ti ti-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      <svg class="ti ti-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
      <span data-theme-label>{t(lang, 'theme.toDark')}</span>
    </button>
    {site.flags.spanish && (
      <nav class="flags" aria-label={t(lang, 'lang.label')}>
        <a href={url(`en/${path}`)} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>
          <Fragment set:html={flagUK} /><span class="sr-only">English</span></a>
        <a href={url(`es/${path}`)} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined}>
          <Fragment set:html={flagES} /><span class="sr-only">Español</span></a>
      </nav>
    )}
    <a class="btn btn-small header-cta" href={`${home}#book`}>{copy.hero.primary}</a>
  </div>
</header>
